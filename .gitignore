# 모델 가중치
*.pth
*.pt
# 공용 YOLO 초기 가중치는 새 환경 재현을 위해 저장소에 포함한다.
!/yolo11m.pt

# 백업
*.bak

# 학습 로그
train_log_*.txt
training_curves.png
training_history.csv

# 시각화 결과
pred_vis*/
inference_best_model_cuboid_soft025/
verify_output/
bad_jpegs_report.csv

# wandb
wandb/

# anchor 바이너리
*.npy
anchor_kmeans_meta.json

# 기타
*.deb
__pycache__/
*.pyc

# 데이터셋 (대용량, NAS 별도 백업). 루트의 실제 디렉터리와 심볼릭 링크 모두 제외.
/dataset

# 세션 임시/진단
_tmp*
*_out/
scratch*.py
*.log

# 백업 파일 (확장명까지)
*.bak*

# 검증 산출물
verify_output/
geom_verify/

# 생성 anchor/split (이미 추적 중인 건 별도 처리함)
anchor_kmeans_*.npy
anchor_kmeans_meta.json
dataset_split_*.json

# visual_audit: 71개 PNG 제외(생성 스크립트/README/index/manifest 만 추적)
visual_audit/**/*.png
# run 결과는 config/metric/log/plot을 추적한다.
# 모델과 재생성 가능한 대용량 raw prediction dump는 GitHub 용량 제한 때문에 제외한다.
runs/**/*.pth
runs/**/*.pt
runs/**/*.ckpt
runs/**/*_preds.npz
# 위쪽의 전역 로그/학습곡선 제외 규칙보다 뒤에서 run 기록은 다시 포함한다.
!runs/**/*.log
!runs/**/training_curves.png
!runs/**/training_history.csv
# 대표 A/B: checkpoint/로그/init 은 제외, 작은 config/metric JSON·리포트는 개별 add
experiments/**/*.pth
experiments/**/*.log
# 세션 scratch / 검증용 임시 run·checkpoint 디렉터리
experiments/_*/
pretrain_verify/pf_*/
pretrain_verify/_recon.sh
pretrain_verify/_show_preflight.py
experiments/representative_ab/_smoke.sh
# 대표 A/B: 학습곡선 PNG(재생성) 제외
experiments/**/training_curves.png
experiments/representative_ab/_extract.py
